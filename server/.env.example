# --- Database ---
# Matches docker-compose (host port 5433 -> container 5432)
DATABASE_URL="postgresql://teamflow:teamflow@localhost:5433/teamflow?schema=public"

# --- Server ---
PORT=4000
NODE_ENV=development
# Comma-separated list of allowed browser origins for CORS
CLIENT_ORIGIN="http://localhost:5173"

# --- Auth ---
# Use a long random string in real deployments
JWT_SECRET="change-me-in-production-please-use-a-long-random-string"
JWT_EXPIRES_IN="7d"

# --- Email (SMTP) ---
# Defaults target the MailHog container from docker-compose.
# View captured mail at http://localhost:8025
SMTP_HOST="localhost"
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="TeamFlow <no-reply@teamflow.local>"

# --- File storage ---
# Local disk acts as the "object storage" abstraction in dev.
UPLOAD_DIR="uploads"
MAX_UPLOAD_MB=10
